# Kamal's secrets (config/deploy.yml `secret:` lists). Only references: the values come from the environment –
# the GitHub environment secrets in the deploy workflow, locally `set -a; . server/.env; set +a` – and are
# never written here (docs/deploy.md).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
OSCT_DB_PASS=$DB_PASS
OSCT_SECRET=$SECRET
OSCT_SMTP_PASS=$SMTP_PASS
# The storage zone's access key (CONTENT_STORE=bunny – the same key the osct CLI uses)
OSCT_BUNNY_STORAGE_PASSWORD=$BUNNY_STORAGE_PASSWORD
# The accessory's own user is the API's database user
MARIADB_PASSWORD=$DB_PASS
MARIADB_ROOT_PASSWORD=$DB_ROOT_PASS
