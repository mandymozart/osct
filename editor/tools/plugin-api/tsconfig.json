{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["three"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@shared/*": ["../../../shared/*"],
      "three": ["../../node_modules/@types/three/index.d.ts"],
      "three/*": ["../../node_modules/@types/three/*"]
    }
  },
  "files": ["entry.ts"]
}
