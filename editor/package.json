{
  "name": "osct-editor",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "description": "The authors' editor of OSCT (docs/editor.md): the engine over the mock stage, served at /editor",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run plugin-api && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "plugin-api": "node tools/plugin-api/generate.mjs"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0",
    "sucrase": "^3.35.1",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.13.9",
    "@types/three": "^0.174.0",
    "dts-bundle-generator": "^9.5.1",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
