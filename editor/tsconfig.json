{
  "extends": "$app/tsconfig",
  "include": ["src", "*"],
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "vite/client", "three"],
    "paths": {
      "@engine/*": ["../engine/src/*"],
      "@shared/*": ["../shared/*"],
      "three": ["./node_modules/@types/three/index.d.ts"],
      "three/*": ["./node_modules/@types/three/*"]
    }
  }
}
