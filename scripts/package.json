    "js-yaml": "^4.1.0",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^22.14.1",
    "@types/pngjs": "^6.0.5",
    "typescript": "~5.7.2",
    "vite": "^6.3.2"
  }
}
