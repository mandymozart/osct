{
  "name": "osct-scripts",
  "private": true,
  "version": "1.2.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:content": "node dist/index.js",
    "build:content:force": "node dist/index.js --force",
    "start": "npm run build && npm run build:content",
    "compile:mind": "npm run build && node dist/mind-compile.js",
    "mind:benchmark": "npm run build && node dist/mind-benchmark.js",
    "mind:history": "npm run build && node dist/mind-history.js",
    "mind:restore": "npm run build && node dist/mind-history.js restore",
    "sounds": "npm run build && node dist/sounds.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.1.0",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^22.14.1",
    "@types/pngjs": "^6.0.5",
    "playwright-core": "^1.63.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.2",
    "vitest": "^3.2.7"
  }
}
