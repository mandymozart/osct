{
  "name": "osct-scripts",
  "private": true,
  "version": "1.19.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "osct": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && vite build",
    "build:content": "node dist/index.js",
    "build:content:force": "node dist/index.js --force",
    "osct": "node dist/cli.js",
    "schema:lock": "npm run build && node dist/schema-lock.js",
    "start": "npm run build && npm run build:content",
    "sounds": "npm run build && node dist/sounds.js",
    "import": "npm run build && node dist/import-delivery.js",
    "protocol": "npm run build && node dist/protocol.js",
    "layout": "python layout/extract-layout.py",
    "test": "vitest run"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.1.0",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^22.14.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.174.0",
    "esbuild": "^0.25.2",
    "three": "^0.174.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.2",
    "vitest": "^4.1.12"
  }
}
