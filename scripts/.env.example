OSCT_BUNNY_STORAGE_ZONE=osct
OSCT_BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
OSCT_BUNNY_STORAGE_PASSWORD=<Key der Storage-Zone>
OSCT_CONTENT_BASE_URL=https://buildingfictions.b-cdn.net/staging
# The site the reader runs on – the CDN check asks with its origin (CORS); optional
OSCT_APP_URL=https://osct.porschuetz.de
OSCT_CONTENT_DIR=C:/Development/osct/osct-content/content

# Google Cloud Vision (Web Detection) – reverse image search for picture credits (#277); an API key restricted to the Cloud Vision API
GOOGLE_VISION_KEY=
