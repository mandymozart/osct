# OSCT accounts API: every request goes to index.php – no other file here is served
# (src/, config.local.php). Deployed as the /api/ folder next to the app.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Apache hides the Authorization header from PHP (CGI / FastCGI) unless it is passed on
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

# Second line of defence if the rewrite is off: nothing but index.php
<FilesMatch "^(?!index\.php$)">
  Require all denied
</FilesMatch>
