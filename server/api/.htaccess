# OSCT user API: every request goes to index.php (it answers 404 for unknown paths, also for files
# like src/*.php). Deployed as the /api/ folder next to the app.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Apache hides the Authorization header from PHP (CGI / FastCGI) unless it is passed on
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

# Second line of defence if the rewrite is off (src/ and db/ have their own "deny all").
# Not a <FilesMatch> on everything but index.php: it runs before the rewrite and would block the API paths.
<Files "config.local.php">
  Require all denied
</Files>
