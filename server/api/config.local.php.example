<?php
// Copy to config.local.php (next to index.php – not committed) and fill in.
// Every key can also come from an environment variable with the prefix OSCT_ (OSCT_DB_PASS …),
// which wins over this file. All keys and defaults: src/Config.php.
return [
    // MySQL / MariaDB. These values are the local MariaDB of docker-compose.yml (`docker compose up -d db` in the
    // repository root – the recommended setup, docs/server.md "Local development"); 127.0.0.1, not localhost, so PDO
    // takes TCP to the container instead of a socket. On a server: its host, database and account.
    'DB_HOST' => '127.0.0.1',
    'DB_PORT' => '3306',
    'DB_NAME' => 'osct',
    'DB_USER' => 'osct',
    'DB_PASS' => 'osct',
    // Quick tests without Docker instead: an SQLite file, created with the schema on first use (wins over DB_*)
    // in var/db/ at the top level of the checkout (server/api/db/ holds the schema only – an older path there is moved)
    // 'DB_SQLITE_PATH' => dirname(__DIR__, 2) . '/var/db/local.sqlite',

    // At least 32 random characters: openssl rand -hex 32
    'SECRET' => '',

    // The app (links in the emails) and other origins allowed to call the API
    'APP_URL' => 'https://osct.example.com',
    'ALLOWED_ORIGINS' => 'https://osct.example.com, https://localhost:5173',

    // log (development: MAIL_LOG_PATH), mail (PHP mail(), testing), smtp (production)
    'MAIL_TRANSPORT' => 'mail',
    'MAIL_FROM' => 'no-reply@osct.example.com',
    'MAIL_FROM_NAME' => 'Onion Skin & Crocodile Tears',
    // The mail log (MAIL_TRANSPORT log) is var/mail/mail.log, the error log var/log/error.log, published content and
    // uploads go to content-store/ – all at the top level of the checkout, git-ignored (docs/server.md "Content store and var")
    // 'MAIL_LOG_PATH' => dirname(__DIR__, 2) . '/var/mail/mail.log',
    // 'CONTENT_STORE_DIR' => dirname(__DIR__, 2) . '/content-store',

    // Sign-in emails per address and per IP and hour (defaults 5 and 30). -1 = no limit – for local testing, where the
    // codes land in the mail log anyway (0 allows nothing); a refused request answers 429 with the seconds until the
    // next is allowed. The same rule for LOGIN_MAX_ATTEMPTS (5) and PASSWORD_MAX_FAILS_PER_EMAIL_HOUR / _IP_HOUR (10 / 30).
    // 'LOGIN_MAX_PER_EMAIL_HOUR' => '-1',
    // 'LOGIN_MAX_PER_IP_HOUR' => '-1',

    // SMTP (MAIL_TRANSPORT = smtp)
    'SMTP_HOST' => '',
    'SMTP_PORT' => '587',
    'SMTP_SECURE' => 'tls', // tls = STARTTLS (587), ssl = 465
    'SMTP_USER' => '',
    'SMTP_PASS' => '',
