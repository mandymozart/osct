# Links like /entry/<id> or /spread/<id> (services/LinkService.ts): every path that is not a file or
# folder is answered with index.html, the app then routes by the URL. The editor (editor/, docs/editor.md) lives
# under /editor with its own index.html and routes the same way.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # The admin page lives in the editor app (docs/admin.md): /admin is the short address for it
  RewriteRule ^admin(/.*)?$ /editor/admin/ [R=302,L]
  # The accounts API (server/) has its own .htaccess – never answer it with the app
  RewriteCond %{REQUEST_URI} !^/api(/|$)
  # The editor's routes (/editor/<book>/<spread>) → its index.html
  RewriteCond %{REQUEST_URI} ^/editor(/|$)
  RewriteRule ^ editor/index.html [L]
  RewriteRule ^ index.html [L]
</IfModule>

# The editor's stage frame (docs/editor.md "The stage frame") is a sandbox with an opaque origin: it fetches the editor's
# scripts and static files and the content served with the app with `Origin: null`. These public files may be read by
# any origin (no credentials – the API answers for itself).
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(editor|assets/content)/#">
    Header set Access-Control-Allow-Origin "*"
  </If>
</IfModule>
