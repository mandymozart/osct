# Links like /entry/<id> or /scene/<id> (services/LinkService.ts): every path that is not a file or
# folder is answered with index.html, the app then routes by the URL. The editor (editor/, docs/editor.md) lives
# under /editor with its own index.html and routes the same way.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # The admin page lives in the editor app (docs/admin.md): /admin is the short address for it
  RewriteRule ^admin(/.*)?$ /editor/admin/ [R=302,L]
  # A missing build file (a hashed chunk – mid-deploy, or from an older build) is a 404, never the app's index.html:
  # served as HTML, a module script fails and the page stays black (2.0.2 on staging)
  RewriteRule ^(editor/)?(_app|assets)/ - [R=404,L]
  # The accounts API (server/) has its own .htaccess – never answer it with the app
  RewriteCond %{REQUEST_URI} !^/api(/|$)
  # The editor's routes (/editor/<experience>/<scene>) → its index.html
  RewriteCond %{REQUEST_URI} ^/editor(/|$)
  RewriteRule ^ editor/index.html [L]
  RewriteRule ^ index.html [L]
</IfModule>

# The editor's stage frame (docs/editor.md "The stage frame") is a sandbox with an opaque origin: it fetches the editor's
# scripts and static files, the content served with the app and the trigger infos (`/trigger-protocol.json`, #240) with
# `Origin: null`. These public files may be read by any origin (no credentials – the API answers for itself).
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/((editor|assets/content)/|trigger-protocol\.json$)#">
    Header set Access-Control-Allow-Origin "*"
    # SvelteKit's version check (`_app/version.json`) asks with these: its preflight must allow them
    Header set Access-Control-Allow-Headers "cache-control, pragma"
  </If>
</IfModule>

# The MCP server as one file (#272, docs/mcp.md): /mcp/osct-mcp.mjs is a download, always the deployed version
AddType text/javascript .mjs
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/mcp/osct-mcp\.mjs$#">
    Header set Cache-Control "no-cache"
    Header set Content-Disposition "attachment; filename=\"osct-mcp.mjs\""
  </If>
</IfModule>
