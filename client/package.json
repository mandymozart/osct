{
  "name": "osct-book-game",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "dev:http": "vite --host --mode http",
    "i18n": "i18next-cli extract && i18next-cli types",
    "i18n:status": "i18next-cli status || echo \"Warning: some translations are missing - English is shown instead (not failing the build).\"",
    "i18n:watch": "i18next-cli extract --watch --with-types",
    "i18n:build": "npm run i18n && npm run i18n:status",
    "prebuild": "npm run i18n:build",
    "build": "vite build && tsc",
    "build:ar-rebuild": "npm run i18n:build && vite build --mode ar-rebuild && tsc",
    "build:ar-persistent": "npm run i18n:build && vite build --mode ar-persistent && tsc",
    "dev:ar-persistent": "vite --host --mode ar-persistent",
    "build:config": "cd scripts && npm run build:content",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "watch": "vitest watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ungap/custom-elements": "^1.3.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^10.0.0"
  },
  "peerDependencies": {
    "aframe": "^1.7.0",
    "aframe-extras": "^7.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "@types/aframe": "^1.2.8",
    "@types/node": "^22.13.9",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitest/coverage-v8": "^1.3.1",
    "aframe": "^1.7.0",
    "happy-dom": "^13.3.8",
    "i18next-cli": "^1.74.1",
    "js-yaml": "^4.1.0",
    "path": "^0.12.7",
    "typescript": "^5.8.2",
    "vite": "^5.4.14",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
