{
  "name": "osct-book-game",
  "version": "1.2.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "dev:http": "vite --host --mode http",
    "dev:api": "php -S 127.0.0.1:8080 -t ../server ../server/api/index.php",
    "i18n": "i18next-cli extract && i18next-cli types",
    "i18n:status": "i18next-cli status || echo \"Warning: some translations are missing - English is shown instead (not failing the build).\"",
    "i18n:watch": "i18next-cli extract --watch --with-types",
    "i18n:build": "npm run i18n && npm run i18n:status",
    "prebuild": "npm run i18n:build",
    "build": "vite build && tsc --noEmit && tsc -p sw",
    "build:config": "cd scripts && npm run build:content",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "watch": "vitest watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ungap/custom-elements": "^1.3.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^10.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "@types/node": "^22.13.9",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "happy-dom": "^20.14.5",
    "i18next-cli": "^1.74.1",
    "js-yaml": "^4.1.0",
    "path": "^0.12.7",
    "terser": "^5.51.2",
    "typescript": "^5.8.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
