{
  "name": "osct-mcp",
  "private": true,
  "version": "1.37.0",
  "description": "OSCT MCP server (stdio): a Claude session as a signed-in editor over the instance's API – the book's draft, assets and plugin sources; the API decides, readers are reached only by a person",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "osct-mcp": "./bin/osct-mcp.mjs"
  },
  "scripts": {
    "start": "node bin/osct-mcp.mjs",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "esbuild": "^0.25.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.14.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.12"
  }
}
