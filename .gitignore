# Dependencies and build output
node_modules
dist
dist-ssr
coverage

# Local files – never committed
*.local
.env
# client/.env holds comments only (documents the VITE_* build flags, no values)
!client/.env
.claude
# Content build output – built by every `npm run build` in client/ (prebuild → `npm run content`), CI and deploys
client/src/game.config.json
client/public/assets/content/

# Server secrets and local data (docs/server.md)
server/api/config.local.php
server/api/db/*.sqlite
server/api/db/*.log
# The local content store (what the editor publishes on this machine)
server/api/db/content/
# Dumps of staging's database (scripts/db/pull-staging.sh) – personal data, never committed
server/db-dumps/

# Logs
logs
*.log

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.venv

# Kamal: only .kamal/secrets (references to environment variables) is committed
.kamal/secrets.*
.kamal/secrets-common
# Trial/final content videos stay out of git – synced to the CDN separately; a build without
# them gives those targets no AR video (warning, not an error)
content/entries/*/video.mp4
# The book's layout for the editor's stage – generated from the designed PDFs (scripts/layout/extract-layout.py)
content/layout/

# The book content lives outside the repository (OSCT_CONTENT_DIR, docs/content-out-of-git.md, #5)
/content/
